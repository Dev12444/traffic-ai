# ── Copy to .env and fill in. Everything here has a safe default in config.py ──

# YOLOv8 detection
YOLO_WEIGHTS=yolov8n.pt        # nano weights; swap to yolov8s.pt / m for accuracy
YOLO_CONF=0.35                 # min detection confidence

# Intersection identity (used when a request omits intersection_id)
DEFAULT_INTERSECTION_ID=INT-001

# Supabase / PostgreSQL (Person B's DB). Leave blank to use the mock CSV sink.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_TABLE=vehicle_counts

# API auth. If blank, the API runs open (fine for local/hackathon demos).
API_KEY=
